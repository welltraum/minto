.DS_Store

# Generated evaluation inputs and isolated judge snapshots
eval/fixtures/*/prompt-*.md
eval/judge-view/

# Historical local research remains available locally, but is not distributed
eval/report-v1.1*.md
eval/report-v1.2.md
eval/report-v1.3.md
eval/report-v1.4.md
eval/snapshots/
eval/runs/*
!eval/runs/v1.5.0/
eval/runs/v1.5.0/logs/
eval/runs/v1.5.0/blind/
eval/runs/v1.5.0/log.txt
# v1.5.0 was blinded before shuffle.txt existed. Regenerating it would stamp
# today's date on a July run, so it stays local; mapping.json is the record.
eval/runs/v1.5.0/shuffle.txt
!eval/runs/v1.5.0-wide/
eval/runs/v1.5.0-wide/logs/
eval/runs/v1.5.0-wide/blind/
eval/runs/v1.5.0-wide/log.txt
