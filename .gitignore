# Resume invocations record themselves separately so a re-run cannot overwrite the
# provenance of the cells already on disk. Incidental; the original is what counts.
eval/runs/*/engines-resume-*.txt

# Credentials. Never committed; the eval reads NEURALDEEP_API_KEY from the
# environment and records only the base URL and request parameters in engines.txt.
.env
.env.*

# Session dialogs collected by scripts/collect_minto_dataset.py contain client
# project content and never leave this machine; only the collector is tracked.
dataset/

# Local source material and transient files
*.pdf
tmp/
.cache/
__pycache__/

# Design-review captures from the impeccable skill: full-page screenshots, a few
# megabytes per round, regenerated on demand. The surface brief beside them is the
# direction contract later sessions reload, so that one is tracked.
.impeccable/review/

# Local launch config for the desktop preview
.claude/
!eval/runs/v1.8.0-final/
