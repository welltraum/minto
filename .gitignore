eval/runs/v1.7.0-baseline/blind/
eval/runs/v1.7.0-baseline/log.txt
# The superseded 5-engine provenance from the invocation the hub outage killed;
# engines.txt (the 8-engine invocation that owns the cells) is the record.
eval/runs/v1.7.0-baseline/engines-superseded-5eng.txt
!eval/runs/v1.7.0/
eval/runs/v1.7.0/logs/
eval/runs/v1.7.0/blind/
eval/runs/v1.7.0/log.txt
!eval/runs/v1.7.0-final/
eval/runs/v1.7.0-final/logs/
eval/runs/v1.7.0-final/blind/
eval/runs/v1.7.0-final/log.txt
